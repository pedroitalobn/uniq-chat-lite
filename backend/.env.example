# ===================
# ENVIRONMENT
# ===================
# Set to "production" to enforce secure defaults (required secrets)
ENV=development

PORT=8080

# Resend — transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=mail@yourdomain.com
APP_NAME=Qchat
APP_URL=https://yourdomain.com

# Auth
JWT_SECRET=change_me_32_chars_minimum_xxxxxxxxxx
JWT_REFRESH_SECRET=change_me_32_chars_minimum_xxxxxxxxx
FRONTEND_URL=https://yourdomain.com

# Logging
LOG_LEVEL=info

# Sessions (WhatsApp)
SESSION_DIR=./sessions

# Proxy encryption (32 chars)
PROXY_ENCRYPTION_KEY=change_me_32_chars_exactly_xxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Asaas (Brazilian payment gateway)
ASAAS_API_KEY=$aas_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASAAS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASAAS_ENVIRONMENT=sandbox

# AbacatePay (PIX payment gateway)
ABACATEPAY_API_KEY=abac_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ABACATEPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database (used in production via docker-compose)
DATABASE_URL=postgres://uniqchat:yourpassword@localhost:5432/uniqchat?sslmode=disable

# RabbitMQ
RABBITMQ_URI=amqp://uniqchat:yourpassword@localhost:5672/

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=uniqchat
MINIO_SECRET_KEY=yourpassword
MINIO_BUCKET=uniqchat-media
MINIO_PUBLIC_URL=https://media.yourdomain.com
MINIO_USE_SSL=false

# ===================
# WHITE-LABEL BOOTSTRAP
# ===================
# Se true, no startup aplica migrations do lite (branding + plano unlimited)
# e cria o usuário admin com as credenciais abaixo (caso ainda não exista).
BOOTSTRAP_ON_START=true
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=mude-isso-agora
ADMIN_NAME=Admin
