# ══════════════════════════════════════════════════════════════════════════════
# Uniq.chat — Production Environment Variables
# Copie para .env e preencha os valores reais.
# No Dokploy: Environment → cole cada variável.
#
# Domínios:
#   Landing   → https://uniq.chat (redireciona para app)
#   App       → https://app.uniq.chat
#   API       → https://api.uniq.chat
#   Media     → https://media.uniq.chat
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=uniqchat_secure_pass_2026

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=uniqchat
RABBITMQ_PASS=uniqchat_rabbitmq_pass_2026

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=uniqchat
MINIO_SECRET_KEY=uniqchat_minio_secret_2026
MINIO_BUCKET=uniqchat-media

# ── Auth secrets ──────────────────────────────────────────────────────────────
JWT_SECRET=supersecretjwtkey_change_in_production_32chars
JWT_REFRESH_SECRET=refreshsecretkey_change_in_production_32ch
NEXTAUTH_SECRET=nextauthsecret_dev_uniqchat_2026_secure

# ── Proxy encryption (exatamente 32 caracteres) ───────────────────────────────
PROXY_ENCRYPTION_KEY=12345678901234567890123456789012

