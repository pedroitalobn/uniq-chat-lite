# ══════════════════════════════════════════════════════════════════════════════
# Uniq.chat — Production Environment Variables
# Copie para .env e preencha os valores reais.
# No Dokploy: Environment → cole cada variável.
#
# Domínios:
#   Frontend  → https://uniq.chat
#   API       → https://api.uniq.chat
#   Media     → https://media.uniq.chat
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=troque_por_senha_forte

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=uniqchat
RABBITMQ_PASS=troque_por_senha_forte

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=uniqchat
MINIO_SECRET_KEY=troque_por_senha_forte
MINIO_BUCKET=uniqchat-media

# ── Auth secrets (gere com: openssl rand -base64 32) ─────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
NEXTAUTH_SECRET=

# ── Proxy encryption (exatamente 32 caracteres) ───────────────────────────────
PROXY_ENCRYPTION_KEY=

# ── Email transacional (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=mail@uniq.chat

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Log level ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
