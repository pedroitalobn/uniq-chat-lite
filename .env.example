# ══════════════════════════════════════════════════════════════════════════════
# Uniq.chat — Environment Variables
# Copy to .env and fill in secrets before deploying.
# Production domain: https://uniq.chat
# ══════════════════════════════════════════════════════════════════════════════

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://uniqchat:uniqchat_secret@localhost:5432/uniqchat?sslmode=disable
JWT_SECRET=supersecretjwtkey_change_in_production_32chars
JWT_REFRESH_SECRET=refreshsecretkey_change_in_production_32ch

# Production → https://uniq.chat | Local dev → http://localhost:3010
FRONTEND_URL=https://uniq.chat

LOG_LEVEL=info
SESSION_DIR=./sessions
# AES-256 key — must be exactly 32 chars
PROXY_ENCRYPTION_KEY=12345678901234567890123456789012

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=uniqchat_secret

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=uniqchat
RABBITMQ_PASS=uniqchat123
RABBITMQ_URI=amqp://uniqchat:uniqchat123@localhost:5672/

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=uniqchat
MINIO_SECRET_KEY=uniqchat123
MINIO_BUCKET=uniqchat-media
MINIO_ENDPOINT=localhost:9010
MINIO_USE_SSL=false
# Production → https://media.uniq.chat | Local → http://localhost:9010
MINIO_PUBLIC_URL=https://media.uniq.chat

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs criados no Stripe Dashboard (Products > Prices)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ── Frontend ──────────────────────────────────────────────────────────────────
# Production → https://api.uniq.chat | Local dev → http://localhost:8080
NEXT_PUBLIC_API_URL=https://api.uniq.chat
NEXTAUTH_SECRET=nextauthsecret_change_in_production
# Production → https://uniq.chat | Local dev → http://localhost:3010
NEXTAUTH_URL=https://uniq.chat
