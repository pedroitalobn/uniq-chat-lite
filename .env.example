# ══════════════════════════════════════════════════════════════════════════════
# Uniq Lite — White-Label Environment Variables (Dokploy compose)
# Copie para .env e preencha. No Dokploy: Project → Environment → cole.
# ══════════════════════════════════════════════════════════════════════════════

# ── Stack identity ────────────────────────────────────────────────────────────
# Prefixo de container_name. Mude pra rodar várias instâncias no mesmo host.
STACK_NAME=uniq

# Nome exibido no app (header, título, emails). Cliente pode trocar depois
# pela UI em /admin/branding — esta env só serve pro primeiro boot.
APP_NAME=Uniq

# ── Domínios públicos (HTTPS, configurados no painel Dokploy → Domains) ──────
# FRONTEND_URL é onde os usuários acessam o app.
# APP_URL é o mesmo (mantido por compat de emails transacionais).
# NEXT_PUBLIC_API_URL é onde o frontend chama a API (precisa ser absoluto e
# resolver no browser do usuário — tipicamente subdomínio "api").
FRONTEND_URL=https://app.seudominio.com
APP_URL=https://app.seudominio.com
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# ── Admin bootstrap (criado no primeiro boot se não existir) ─────────────────
BOOTSTRAP_ON_START=true
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=trocar-no-primeiro-login
ADMIN_NAME=Admin

# ── White-label feature flags ────────────────────────────────────────────────
# true = módulo visível, false = oculto. Os 4 estão ocultos por padrão no lite.
NEXT_PUBLIC_ENABLE_SHOPS=false
NEXT_PUBLIC_ENABLE_HELPDESK=false
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_ENABLE_USAGE=false

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=uniq
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=uniq

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=uniq
RABBITMQ_PASS=change_me_rabbitmq_password

# ── Auth secrets (gere com `openssl rand -hex 32`) ───────────────────────────
JWT_SECRET=change_me_32_chars_minimum_xxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_32_chars_minimum_xxxxxxxxx
NEXTAUTH_SECRET=change_me_nextauth_secret_32chars_min

# 32 caracteres exatos.
PROXY_ENCRYPTION_KEY=change_me_32_chars_exactly_xxxxx

# ── Storage S3-compatible (Hetzner / Cloudflare R2 / AWS S3 / MinIO) ─────────
MINIO_ENDPOINT=s3.suaregiao.provider.com
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=uniq-lite-media
MINIO_PUBLIC_URL=https://media.seudominio.com
MINIO_USE_SSL=true

# ── Email transacional (Resend) — opcional ───────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=no-reply@seudominio.com

# ── Stripe — opcional, só se habilitar NEXT_PUBLIC_ENABLE_BILLING=true ───────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Meta WhatsApp Cloud API (WABA) — opcional ────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
